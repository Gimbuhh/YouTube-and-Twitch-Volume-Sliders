{
  "name": "youtube-twitch-volume-sliders",
  "version": "2.9",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "docs:screenshots": "node scripts/build.mjs && node tests/browser/normalization-icon.mjs --update-docs",
    "test": "node scripts/build.mjs && node --test && node scripts/browser-checks.mjs",
    "test:node": "node --test",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\"",
    "test:browser": "node scripts/build.mjs && node tests/browser/smoke.mjs && node tests/browser/normalization-icon.mjs",
    "test:browsers": "node scripts/build.mjs && node scripts/browser-checks.mjs",
    "test:chrome": "node scripts/build.mjs && node scripts/browser-checks.mjs chrome",
    "test:normalization-browser": "node scripts/build.mjs && node tests/browser/normalization.mjs && node tests/browser/native-audio-startup.mjs && node tests/browser/native-gain-graph.mjs",
    "test:firefox": "node scripts/build.mjs && node scripts/browser-checks.mjs firefox",
    "browsers:install": "node node_modules/playwright-core/cli.js install firefox",
    "test:normalization-compare": "node scripts/compare-normalization.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:metadata": "node scripts/validate-metadata.mjs",
    "check:generated": "node scripts/verify-generated.mjs",
    "check:archive": "node scripts/archive-manifest.mjs",
    "check:security": "node scripts/security-scan.mjs",
    "history:generate": "node scripts/generate-historical-releases.mjs",
    "check:core": "node scripts/archive-manifest.mjs && node scripts/build.mjs && node scripts/validate-metadata.mjs && node scripts/check-syntax.mjs && node --test && node scripts/verify-generated.mjs && node scripts/security-scan.mjs",
    "check": "npm run check:core && node scripts/browser-checks.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "playwright-core": "1.63.0"
  }
}
